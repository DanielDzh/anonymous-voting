# Admin login for /admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Random string used to sign the admin session cookie: `openssl rand -base64 32`
SESSION_SECRET=

# Public address used in the QR link (set it for real deployments / custom domains).
# Leave empty locally: the QR then uses this machine's current LAN IP automatically.
PUBLIC_URL=

# Postgres connection string (Neon: Dashboard → Connect → copy the postgresql://… string).
# Then create the tables once: `npm run db:push`
DATABASE_URL=
